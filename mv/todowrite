## Phase 3: Data Migration

### Step 3.1: Core Data Migration Command

Create `app/Console/Commands/MigrateEmployeesToUsers.php`:

```php
<?php

namespace App\Console\Commands;

use App\Models\User;
use App\Models\Branch;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;

class MigrateEmployeesToUsers extends Command
{
    protected $signature = 'migration:employees-to-users
                            {--dry-run : Run without making changes}
                            {--batch-size=100 : Number of records to process at once}
                            {--skip-validation : Skip pre-migration validation}';

    protected $description = 'Migrate employee data to users table with proper roles';

    protected $migrationId;
    protected $dryRun = false;
    protected $batchSize = 100;

    public function handle()
    {
        $this->dryRun = $this->option('dry-run');
        $this->batchSize = (int) $this->option('batch-size');

        if ($this->dryRun) {
            $this->warn('DRY RUN MODE - No changes will be made');
        }

        // Record migration start
        $this->migrationId = $this->recordMigrationStart();

        try {
            // Pre-migration validation
            if (!$this->option('skip-validation')) {
                $this->call('migration:validate-pre');
            }

            // Get migration statistics
            $stats = $this->getMigrationStats();
            $this->displayStats($stats);

            if (!$this->confirm('Proceed with migration?')) {
                return Command::SUCCESS;
            }

            // Execute migration in batches
            $this->executeMigration($stats);

            // Post-migration verification
            $this->verifyMigration();

            // Record success
            $this->recordMigrationSuccess();

            $this->info('Migration completed successfully!');
            return Command::SUCCESS;

        } catch (\Exception $e) {
            $this->recordMigrationFailure($e);
            $this->error('Migration failed: ' . $e->getMessage());
            return Command::FAILURE;
        }
    }

    protected function getMigrationStats(): array
    {
        return [
            'total_employees' => DB::table('employees')->count(),
            'existing_users' => DB::table('users')->count(),
            'duplicate_emails' => $this->getDuplicateEmails(),
            'orphaned_employees' => $this->getOrphanedEmployees(),
        ];
    }

    protected function getDuplicateEmails(): int
    {
        return DB::select("
            SELECT COUNT(*) as count FROM (
                SELECT email FROM users
                UNION ALL
                SELECT email FROM employees
            ) combined
            GROUP BY email
            HAVING COUNT(*) > 1
        ");
    }

    protected function getOrphanedEmployees(): int
    {
        return DB::table('employees')
            ->leftJoin('branches', 'employees.branch_id', '=', 'branches.id')
            ->whereNull('branches.id')
            ->count();
    }

    protected function displayStats(array $stats): void
    {
        $this->info('Migration Statistics:');
        $this->table(
            ['Metric', 'Count'],
            [
                ['Total Employees', $stats['total_employees']],
                ['Existing Users', $stats['existing_users']],
                ['Duplicate Emails', $stats['duplicate_emails']],
                ['Orphaned Employees', $stats['orphaned_employees']],
                ['Expected Total Users', $stats['existing_users'] + $stats['total_employees'] - $stats['duplicate_emails']],
            ]
        );
    }

    protected function executeMigration(array $stats): void
    {
        $progressBar = $this->output->createProgressBar($stats['total_employees']);
        $progressBar->start();

        DB::table('employees')
            ->orderBy('id')
            ->chunk($this->batchSize, function ($employees) use ($progressBar) {
                foreach ($employees as $employee) {
                    $this->migrateEmployee($employee);
                    $progressBar->advance();
                }
            });

        $progressBar->finish();
        $this->newLine();
    }

    protected function migrateEmployee($employee): void
    {
        // Check if user already exists
        $existingUser = User::where('email', $employee->email)->first();

        if ($existingUser) {
            $this->warn("Skipping existing user: {$employee->email}");
            return;
        }

        // Validate branch exists
        if ($employee->branch_id && !Branch::find($employee->branch_id)) {
            $this->warn("Invalid branch_id for employee {$employee->email}: {$employee->branch_id}");
            // Continue with null branch_id
            $employee->branch_id = null;
        }

        $userData = [
            'name' => $employee->name,
            'email' => $employee->email,
            'password' => $employee->password, // Assuming same hash
            'branch_id' => $employee->branch_id,
            'is_active' => true,
            'created_at' => $employee->created_at ?? now(),
            'updated_at' => $employee->updated_at ?? now(),
        ];

        if (!$this->dryRun) {
            $user = User::create($userData);

            // Assign role based on employee data analysis
            $role = $this->determineEmployeeRole($employee);
            $user->assignRole($role);

            $this->info("Migrated: {$user->email} -> {$role}");
        } else {
            $role = $this->determineEmployeeRole($employee);
            $this->info("[DRY RUN] Would migrate: {$employee->email} -> {$role}");
        }
    }

    protected function determineEmployeeRole($employee): string
    {
        // This logic should be customized based on your current employee permission structure
        // For now, default to employee role
        // You might analyze current permissions, job titles, or other fields

        // Example logic:
        if (isset($employee->is_manager) && $employee->is_manager) {
            return 'branch-manager';
        }

        if (isset($employee->is_supervisor) && $employee->is_supervisor) {
            return 'supervisor';
        }

        return 'employee';
    }

    protected function verifyMigration(): void
    {
        $this->info('Running post-migration verification...');

        // Count migrated users
        $newUsersCount = User::whereNotNull('branch_id')->count();
        $this->info("New users with branch_id: {$newUsersCount}");

        // Check role assignments
        $rolesAssigned = DB::table('model_has_roles')
            ->join('users', 'model_has_roles.model_id', '=', 'users.id')
            ->where('model_has_roles.model_type', User::class)
            ->count();
        $this->info("Users with roles assigned: {$rolesAssigned}");

        // Verify no duplicate emails
        $duplicateCheck = DB::select("
            SELECT email, COUNT(*) as count
            FROM users
            GROUP BY email
            HAVING count > 1
        ");

        if (!empty($duplicateCheck)) {
            throw new \Exception('Duplicate emails found after migration');
        }

        $this->info('Post-migration verification passed!');
    }

    protected function recordMigrationStart(): int
    {
        if ($this->dryRun) return 0;

        return DB::table('migration_metadata')->insertGetId([
            'migration_type' => 'employees_to_users',
            'metadata' => json_encode([
                'dry_run' => $this->dryRun,
                'batch_size' => $this->batchSize,
                'command' => $this->signature,
            ]),
            'executed_at' => now(),
            'status' => 'running',
        ]);
    }

    protected function recordMigrationSuccess(): void
    {
        if ($this->dryRun) return;

        DB::table('migration_metadata')
            ->where('id', $this->migrationId)
            ->update([
                'status' => 'completed',
                'updated_at' => now(),
            ]);
    }

    protected function recordMigrationFailure(\Exception $e): void
    {
        if ($this->dryRun) return;

        DB::table('migration_metadata')
            ->where('id', $this->migrationId)
            ->update([
                'status' => 'failed',
                'error_message' => $e->getMessage(),
                'updated_at' => now(),
            ]);
    }
}
```

### Step 3.2: Role Assignment Enhancement

Create `app/Console/Commands/AssignEmployeeRoles.php` for more sophisticated role assignment:

```php
<?php

namespace App\Console\Commands;

use App\Models\User;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;

class AssignEmployeeRoles extends Command
{
    protected $signature = 'migration:assign-employee-roles
                            {--dry-run : Preview role assignments}
                            {--reset : Remove existing role assignments first}';

    protected $description = 'Assign appropriate roles to migrated employees based on analysis';

    protected $roleMapping = [
        'admin' => 'admin',
        'manager' => 'branch-manager',
        'supervisor' => 'supervisor',
        'lead' => 'supervisor',
        'senior' => 'supervisor',
        'employee' => 'employee',
        'staff' => 'employee',
    ];

    public function handle()
    {
        if ($this->option('reset')) {
            if (!$this->confirm('Remove all existing role assignments?')) {
                return;
            }

            if (!$this->option('dry-run')) {
                DB::table('model_has_roles')
                    ->where('model_type', User::class)
                    ->delete();
            }
        }

        // Get employees with potential role indicators
        $employees = $this->getEmployeesForRoleAssignment();

        $progressBar = $this->output->createProgressBar(count($employees));
        $progressBar->start();

        foreach ($employees as $employee) {
            $suggestedRole = $this->analyzeEmployeeRole($employee);

            if ($this->option('dry-run')) {
                $this->info("[DRY RUN] {$employee->email} -> {$suggestedRole}");
            } else {
                $user = User::where('email', $employee->email)->first();
                if ($user) {
                    $user->syncRoles([$suggestedRole]);
                    $this->info("Assigned: {$employee->email} -> {$suggestedRole}");
                }
            }

            $progressBar->advance();
        }

        $progressBar->finish();
        $this->newLine();
    }

    protected function getEmployeesForRoleAssignment(): array
    {
        // This query should be customized based on your employee table structure
        // Look for fields that might indicate role (job_title, permissions, etc.)

        return DB::table('employees')
            ->leftJoin('users', 'employees.email', '=', 'users.email')
            ->whereNotNull('users.id')
            ->select('employees.*', 'users.id as user_id')
            ->get()
            ->toArray();
    }

    protected function analyzeEmployeeRole($employee): string
    {
        // Analyze various fields to determine appropriate role

        // Check job title or position field
        if (isset($employee->job_title)) {
            $title = strtolower($employee->job_title);

            foreach ($this->roleMapping as $keyword => $role) {
                if (str_contains($title, $keyword)) {
                    return $role;
                }
            }
        }

        // Check permissions or access level field
        if (isset($employee->access_level)) {
            switch ($employee->access_level) {
                case 'admin':
                case 'administrator':
                    return 'admin';
                case 'manager':
                    return 'branch-manager';
                case 'supervisor':
                    return 'supervisor';
            }
        }

        // Check department or role field
        if (isset($employee->department)) {
            $dept = strtolower($employee->department);

            if (str_contains($dept, 'management') || str_contains($dept, 'admin')) {
                return 'branch-manager';
            }
        }

        // Default to employee role
        return 'employee';
    }
}

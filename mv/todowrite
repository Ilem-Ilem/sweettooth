### Step 6.1: Comprehensive Rollback Strategy

Create `app/Console/Commands/RollbackMigration.php`:

```php
<?php

namespace App\Console\Commands;

use App\Models\User;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

class RollbackMigration extends Command
{
    protected $signature = 'migration:rollback
                            {--force : Skip confirmation prompts}
                            {--step-by-step : Execute rollback steps one by one}';

    protected $description = 'Rollback employees-to-users migration';

    protected $rollbackSteps = [
        'remove_role_assignments' => 'Remove role assignments from migrated users',
        'remove_migrated_users' => 'Remove users created during migration',
        'drop_permission_tables' => 'Drop spatie permission tables',
        'restore_user_columns' => 'Remove added columns from users table',
        'restore_auth_config' => 'Restore dual-guard configuration',
    ];

    public function handle()
    {
        if (!$this->option('force')) {
            $this->warn('⚠️  This will rollback the employees-to-users migration!');
            $this->warn('All migrated users and role assignments will be lost.');

            if (!$this->confirm('Are you sure you want to proceed?')) {
                return Command::SUCCESS;
            }
        }

        // Get migration metadata
        $migration = DB::table('migration_metadata')
            ->where('migration_type', 'employees_to_users')
            ->where('status', 'completed')
            ->first();

        if (!$migration) {
            $this->error('No completed migration found to rollback');
            return Command::FAILURE;
        }

        $this->info('Starting rollback process...');

        try {
            if ($this->option('step-by-step')) {
                $this->executeStepByStepRollback();
            } else {
                $this->executeFullRollback();
            }

            // Mark migration as rolled back
            DB::table('migration_metadata')
                ->where('id', $migration->id)
                ->update([
                    'status' => 'rolled_back',
                    'updated_at' => now(),
                ]);

            $this->info('✅ Rollback completed successfully!');
            return Command::SUCCESS;

        } catch (\Exception $e) {
            $this->error('❌ Rollback failed: ' . $e->getMessage());

            // Log failure
            DB::table('migration_metadata')
                ->where('id', $migration->id)
                ->update([
                    'status' => 'rollback_failed',
                    'error_message' => $e->getMessage(),
                    'updated_at' => now(),
                ]);

            return Command::FAILURE;
        }
    }

    protected function executeStepByStepRollback(): void
    {
        foreach ($this->rollbackSteps as $step => $description) {
            $this->info("Step: {$description}");

            if (!$this->option('force') && !$this->confirm('Execute this step?')) {
                $this->warn('Skipping step...');
                continue;
            }

            $this->{$step}();
            $this->info('✅ Step completed');
        }
    }

    protected function executeFullRollback(): void
    {
        $progressBar = $this->output->createProgressBar(count($this->rollbackSteps));
        $progressBar->start();

        foreach ($this->rollbackSteps as $step => $description) {
            $this->info("Executing: {$description}");
            $this->{$step}();
            $progressBar->advance();
        }

        $progressBar->finish();
        $this->newLine();
    }

    protected function remove_role_assignments(): void
    {
        // Remove all role assignments from users
        DB::table('model_has_roles')
            ->where('model_type', User::class)
            ->delete();

        $this->info('Role assignments removed');
    }

    protected function remove_migrated_users(): void
    {
        // Remove users that were created during migration
        // This assumes migrated users have branch_id set
        $count = User::whereNotNull('branch_id')->delete();

        $this->info("Removed {$count} migrated users");
    }

    protected function drop_permission_tables(): void
    {
        // Drop spatie permission tables
        Schema::dropIfExists('role_has_permissions');
        Schema::dropIfExists('model_has_roles');
        Schema::dropIfExists('model_has_permissions');
        Schema::dropIfExists('permissions');
        Schema::dropIfExists('roles');

        $this->info('Permission tables dropped');
    }

    protected function restore_user_columns(): void
    {
        // Remove added columns from users table
        Schema::table('users', function ($table) {
            $table->dropColumn(['branch_id', 'is_active']);
        });

        $this->info('User table columns restored');
    }

    protected function restore_auth_config(): void
    {
        // This would typically be a manual step
        $this->warn('Manual step required: Restore config/auth.php to include employees guard');
        $this->warn('See backup configuration for reference');

        // Could potentially create a backup/restore mechanism here
    }
}

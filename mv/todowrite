## Phase 5: Verification & Testing

### Step 5.1: Post-Migration Verification Command

Create `app/Console/Commands/VerifyMigration.php`:

```php
<?php

namespace App\Console\Commands;

use App\Models\User;
use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;

class VerifyMigration extends Command
{
    protected $signature = 'migration:verify';
    protected $description = 'Verify migration integrity and data consistency';

    protected $checks = [
        'user_count' => 'Verify user count matches expected total',
        'duplicate_emails' => 'Check for duplicate emails',
        'role_assignments' => 'Verify all users have roles assigned',
        'branch_references' => 'Check branch_id references are valid',
        'permission_integrity' => 'Verify permission system integrity',
        'authentication' => 'Test authentication with new system',
    ];

    public function handle()
    {
        $this->info('Starting post-migration verification...');

        $results = [];

        foreach ($this->checks as $check => $description) {
            $this->info("Running: {$description}");
            $results[$check] = $this->{$check}();
        }

        $this->displayResults($results);

        $failedChecks = array_filter($results, fn($result) => !$result['passed']);

        if (empty($failedChecks)) {
            $this->info('✅ All verification checks passed!');
            return Command::SUCCESS;
        } else {
            $this->error('❌ Some verification checks failed:');
            foreach ($failedChecks as $check => $result) {
                $this->error("- {$check}: {$result['message']}");
            }
            return Command::FAILURE;
        }
    }

    protected function userCount(): array
    {
        $originalUsers = DB::table('migration_metadata')
            ->where('migration_type', 'employees_to_users')
            ->where('status', 'completed')
            ->value('metadata->original_user_count') ?? 0;

        $originalEmployees = DB::table('migration_metadata')
            ->where('migration_type', 'employees_to_users')
            ->where('status', 'completed')
            ->value('metadata->employee_count') ?? 0;

        $expectedTotal = $originalUsers + $originalEmployees;
        $actualTotal = User::count();

        if ($actualTotal === $expectedTotal) {
            return ['passed' => true, 'message' => "User count correct: {$actualTotal}"];
        } else {
            return [
                'passed' => false,
                'message' => "User count mismatch. Expected: {$expectedTotal}, Actual: {$actualTotal}"
            ];
        }
    }

    protected function duplicateEmails(): array
    {
        $duplicates = DB::select("
            SELECT email, COUNT(*) as count
            FROM users
            GROUP BY email
            HAVING count > 1
        ");

        if (empty($duplicates)) {
            return ['passed' => true, 'message' => 'No duplicate emails found'];
        } else {
            $count = count($duplicates);
            return [
                'passed' => false,
                'message' => "{$count} duplicate email(s) found"
            ];
        }
    }

    protected function roleAssignments(): array
    {
        $usersWithoutRoles = User::whereDoesntHave('roles')->count();

        if ($usersWithoutRoles === 0) {
            return ['passed' => true, 'message' => 'All users have roles assigned'];
        } else {
            return [
                'passed' => false,
                'message' => "{$usersWithoutRoles} users without role assignments"
            ];
        }
    }

    protected function branchReferences(): array
    {
        $invalidBranches = User::whereNotNull('branch_id')
            ->whereNotIn('branch_id', function($query) {
                $query->select('id')->from('branches');
            })
            ->count();

        if ($invalidBranches === 0) {
            return ['passed' => true, 'message' => 'All branch references are valid'];
        } else {
            return [
                'passed' => false,
                'message' => "{$invalidBranches} users with invalid branch_id"
            ];
        }
    }

    protected function permissionIntegrity(): array
    {
        // Check that all role-permission relationships are valid
        $invalidRolePerms = DB::table('role_has_permissions')
            ->leftJoin('roles', 'role_has_permissions.role_id', '=', 'roles.id')
            ->leftJoin('permissions', 'role_has_permissions.permission_id', '=', 'permissions.id')
            ->whereNull('roles.id')
            ->orWhereNull('permissions.id')
            ->count();

        if ($invalidRolePerms === 0) {
            return ['passed' => true, 'message' => 'Permission system integrity intact'];
        } else {
            return [
                'passed' => false,
                'message' => "{$invalidRolePerms} invalid role-permission relationships"
            ];
        }
    }

    protected function authentication(): array
    {
        // Test basic authentication (this would need more sophisticated testing)
        try {
            $testUser = User::where('is_active', true)->first();

            if (!$testUser) {
                return [
                    'passed' => false,
                    'message' => 'No active users found for authentication test'
                ];
            }

            // This is a basic check - in real scenarios you'd want more comprehensive auth testing
            $hasRoles = $testUser->roles()->exists();

            if ($hasRoles) {
                return ['passed' => true, 'message' => 'Authentication system appears functional'];
            } else {
                return [
                    'passed' => false,
                    'message' => 'Test user has no roles assigned'
                ];
            }

        } catch (\Exception $e) {
            return [
                'passed' => false,
                'message' => 'Authentication test failed: ' . $e->getMessage()
            ];
        }
    }

    protected function displayResults(array $results): void
    {
        $this->table(
            ['Check', 'Status', 'Message'],
            array_map(function($check, $result) {
                return [
                    $check,
                    $result['passed'] ? '✅ PASS' : '❌ FAIL',
                    $result['message']
                ];
            }, array_keys($results), $results)
        );
    }
}

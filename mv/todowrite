### Step 1.2: Data Validation Scripts

Create `app/Console/Commands/ValidatePreMigration.php`:

```php
<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Illuminate\Support\Facades\DB;

class ValidatePreMigration extends Command
{
    protected $signature = 'migration:validate-pre';
    protected $description = 'Validate data before migration';

    public function handle()
    {
        $this->info('Validating pre-migration data...');

        // Check for duplicate emails
        $duplicateEmails = DB::select("
            SELECT email, COUNT(*) as count
            FROM (
                SELECT email FROM users
                UNION ALL
                SELECT email FROM employees
            ) combined
            GROUP BY email
            HAVING count > 1
        ");

        if (!empty($duplicateEmails)) {
            $this->error('Duplicate emails found:');
            foreach ($duplicateEmails as $dup) {
                $this->error("- {$dup->email} (appears {$dup->count} times)");
            }
            return Command::FAILURE;
        }

        // Check employees table structure
        $employeeColumns = DB::getSchemaBuilder()->getColumnListing('employees');
        $requiredColumns = ['id', 'name', 'email', 'password', 'branch_id'];

        foreach ($requiredColumns as $column) {
            if (!in_array($column, $employeeColumns)) {
                $this->error("Missing required column in employees table: {$column}");
                return Command::FAILURE;
            }
        }

        // Count records
        $userCount = DB::table('users')->count();
        $employeeCount = DB::table('employees')->count();

        $this->info("Users table: {$userCount} records");
        $this->info("Employees table: {$employeeCount} records");
        $this->info("Total expected after migration: " . ($userCount + $employeeCount));

        $this->info('Pre-migration validation passed!');
        return Command::SUCCESS;
    }
}
```


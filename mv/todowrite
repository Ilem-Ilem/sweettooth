/**
 * Emergency rollback script - run directly with PHP if artisan is unavailable
 * Usage: php rollback_emergency.php
 */

require_once __DIR__.'/vendor/autoload.php';

echo "Starting emergency rollback...\n";

// Database connection
$config = require __DIR__.'/config/database.php';
$connection = $config['connections'][$config['default']];

// Connect to database
try {
    $pdo = new PDO(
        "mysql:host={$connection['host']};dbname={$connection['database']}",
        $connection['username'],
        $connection['password']
    );
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

    echo "Connected to database\n";

    // Execute rollback steps
    $steps = [
        "DELETE FROM model_has_roles WHERE model_type = 'App\\\\Models\\\\User'",
        "DELETE FROM users WHERE branch_id IS NOT NULL",
        "DROP TABLE IF EXISTS role_has_permissions",
        "DROP TABLE IF EXISTS model_has_roles",
        "DROP TABLE IF EXISTS model_has_permissions",
        "DROP TABLE IF EXISTS permissions",
        "DROP TABLE IF EXISTS roles",
        "ALTER TABLE users DROP COLUMN branch_id, DROP COLUMN is_active",
    ];

    foreach ($steps as $step) {
        echo "Executing: {$step}\n";
        $pdo->exec($step);
        echo "✅ Step completed\n";
    }

    echo "✅ Emergency rollback completed!\n";
    echo "⚠️  Remember to restore config/auth.php manually\n";

} catch (Exception $e) {
    echo "❌ Emergency rollback failed: " . $e->getMessage() . "\n";
    exit(1);
